# Runtime: development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Compose data services. Replace with secret-manager values outside local development.
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change-this-local-password
REDIS_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://knowledge:change-this-local-password@postgres:5432/knowledge
REDIS_URL=redis://:change-this-local-password@redis:6379/0

# Authentication. disabled is accepted only outside production.
AUTH_MODE=disabled
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=knowledge-assistant-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_ALGORITHMS=RS256
OIDC_ROLES_CLAIM=roles
OIDC_TENANT_CLAIM=tenant_id
DEV_SUBJECT=local-admin
DEV_TENANT_ID=local
DEV_ROLES=reader,editor,admin

# Browser and proxy boundary
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
METRICS_BEARER_TOKEN=change-this-metrics-token
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_OIDC_AUTHORITY=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_REDIRECT_URI=
NEXT_PUBLIC_OIDC_SCOPE=openid profile

# Model provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Retrieval and ingestion limits
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
DEFAULT_TOP_K=5
RETRIEVAL_MIN_SCORE=0.05
RETRIEVAL_MIN_RELATIVE_SCORE=0.20
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=250
MAX_EXTRACTED_CHARACTERS=2000000
CLAMAV_HOST=
CLAMAV_PORT=3310
REQUIRE_MALWARE_SCAN=false

# Abuse controls
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_CHAT=20
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_EVALUATION=10

# Optional OTLP/HTTP collector endpoint, e.g. http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rag-knowledge-assistant
